# ── Provider — pick one ───────────────────────────────────────────────────────

# Option A: OpenRouter (default, no Docker needed)
PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Option B: Open WebUI (run `docker compose up -d` first, no API key needed)
# PROVIDER=openwebui
# OPENWEBUI_URL=http://localhost:4000
# OPENWEBUI_MODEL=deepseek/deepseek-v4-flash  # must match a model loaded in Open WebUI

# Option C: Local Ollama
# PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL — get free connection string at neon.tech
DATABASE_URL=postgresql://...

# ── Rate limiting (optional) ────────────────────────────────────────────────────
# Upstash Redis — free tier at upstash.com. Without these set, rate limits set in
# /admin are saved but not enforced (chat works normally, no throttling).
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
